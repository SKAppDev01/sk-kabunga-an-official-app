{
  "expo": {
    "name": "SKLocal",
    "slug": "SKLocal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sk-kabunga-an-logo.png",
    "scheme": "sklocal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3F2FD",
        "foregroundImage": "./assets/images/sk-kabunga-an-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gzexperience.SKLocal",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3F2FD",
          "image": "./assets/images/sk-kabunga-an-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/sk-kabunga-an-logo.png",
            "backgroundColor": "#E3F2FD"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SK Kabunga-an to use the camera to scan QR codes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fdfd3ef2-6940-466c-8951-1fe571920f5c"
      }
    },
    "owner": "gzexperience",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "url": "https://u.expo.dev/fdfd3ef2-6940-466c-8951-1fe571920f5c"
    }
  }
}
