# Application Environment & Server Settings
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Connection (PostgreSQL connection string format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public

# Security & Authentication (JWT Secrets must be strong random values of at least 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration (Comma-separated origins or *)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Initial Super Admin Account Seeding Settings
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=sk.kabungaan.admin@gmail.com
SEED_ADMIN_PASSWORD=
